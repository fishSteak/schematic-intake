        "封装名",
        "电气正确性"
      ],
      "verdict": {
        "pass": "用户网名非空且全部合法",
        "fail": "至少一条含空格、中文、+、-、.或其他非法字符",
        "insufficient": "原理图抽不出网标",
        "na": "空板已在门禁停评"
      },
      "calibers": [
        "+12V的+不在默认允许集→否",
        "任务书明文允许电源网+/-/.时只对写明的那类网生效"
