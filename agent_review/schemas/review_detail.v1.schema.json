{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Presentation detail.v1 (independent of electrical review schemas)",
  "type":"object",
  "required":["version","module_order","module_titles","headline","verdict","materials","premises","reasoning_steps","assessment_title","assessment_rows","assessment_text","assessment_checks","primary","comparisons","audit_scenarios","evidence","gaps","basis","prose_status","notes"],
  "properties":{
    "version":{"const":"detail.v1"},
    "module_order":{"const":["summary","premises","assessment","primary","comparisons","audit","datasheets","schematics"]},
    "module_titles":{"type":"object"},
    "headline":{"type":"string"},
    "verdict":{"enum":["pass","fail","pending","not_applicable"]},
    "materials":{"type":"array","items":{"type":"object","required":["label","text"],"properties":{"label":{"type":"string"},"text":{"type":"string"}}}},
    "premises":{"type":"array","items":{"type":"object","required":["text"]}},
    "reasoning_steps":{"type":"array","maxItems":3,"items":{"type":"string"}},
    "assessment_title":{"type":"string"},
    "assessment_rows":{"type":"array","items":{"type":"object","required":["label","text"]}},
    "assessment_text":{"type":"string"},
    "assessment_checks":{"type":"array"},
    "primary":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/scenario"}]},
    "comparisons":{"type":"array","items":{"$ref":"#/$defs/scenario"}},
    "audit_scenarios":{"type":"array"},
    "evidence":{"type":"array"},
    "gaps":{"type":"array"},
    "basis":{"type":"object"},
    "prose_status":{"enum":["native","original","ready","source_insufficient","source_conflict"]},
    "notes":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"scenario":{"type":"object","required":["id","title","route_summary","conditions","calculations"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"route_summary":{"type":"string"},"conditions":{"type":"array"},"calculations":{"type":"array"}}}}
}
