{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "facts",
    "conflicts",
    "requests",
    "search_log"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence.v1"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "resolution",
          "fact_refs",
          "status"
        ],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string"
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "search_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "purpose",
          "outcome"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "required": [
        "rule_id",
        "object"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "object": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "locator",
        "quote"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "value",
        "conditions",
        "evidence",
        "affected_pairs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "affected_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          },
          "minItems": 1
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "id",
        "category",
        "question",
        "decision_impact",
        "why_unavailable",
        "attempts",
        "affected_pairs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "business_fact",
            "public_material",
            "reasoning",
            "execution"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "decision_impact": {
          "type": "string",
          "minLength": 1
        },
        "why_unavailable": {
          "type": "string",
          "minLength": 1
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "minimum_answer": {
          "type": "string"
        },
        "alternative": {
          "type": "string"
        }
      }
    }
  }
}
