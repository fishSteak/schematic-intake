# Insert inside fishsteak.xyz's route, before the catch-all Hermes handler.
# Preserve Host; Caddy supplies X-Forwarded-Proto and strips only this prefix.
handle /schematic {
    redir * /schematic/ 308
}
handle_path /schematic/* {
    # Compress UI, PDF.js and JSON; PDF byte ranges and SSE stay untouched.
    encode zstd gzip {
        match {
            header Content-Type text/html*
            header Content-Type text/css*
            header Content-Type text/javascript*
            header Content-Type application/javascript*
            header Content-Type application/json*
            header Content-Type image/svg+xml*
        }
    }
    reverse_proxy 127.0.0.1:8767 {
        flush_interval -1
    }
}
